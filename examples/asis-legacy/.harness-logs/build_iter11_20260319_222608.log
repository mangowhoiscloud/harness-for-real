{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G5gv2kDhRKKo2SzDCzvRJC","type":"tool_result","content":"     1→<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n     2→<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\"\n     3→        \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\">\n     4→\n     5→<mapper namespace=\"com.example.legacy.mapper.EmployeeMapper\">\n     6→\n     7→    <resultMap id=\"employeeResultMap\" type=\"Employee\">\n     8→        <id property=\"id\" column=\"id\"/>\n     9→        <result property=\"name\" column=\"name\"/>\n    10→        <result property=\"email\" column=\"email\"/>\n    11→        <result property=\"department\" column=\"department\"/>\n    12→        <result property=\"salary\" column=\"salary\"/>\n    13→        <result property=\"hireDate\" column=\"hire_date\"/>\n    14→        <result property=\"createdAt\" column=\"created_at\"/>\n    15→        <result property=\"updatedAt\" column=\"updated_at\"/>\n    16→    </resultMap>\n    17→\n    18→    <select id=\"findAll\" resultMap=\"employeeResultMap\">\n    19→        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n    20→        FROM employees\n    21→        ORDER BY id\n    22→        LIMIT #{limit} OFFSET #{offset}\n    23→    </select>\n    24→\n    25→    <select id=\"findById\" resultMap=\"employeeResultMap\">\n    26→        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n    27→        FROM employees\n    28→        WHERE id = #{id}\n    29→    </select>\n    30→\n    31→    <!-- useGeneratedKeys returns the DB-generated PK back into employee.id -->\n    32→    <insert id=\"insert\" useGeneratedKeys=\"true\" keyProperty=\"id\">\n    33→        INSERT INTO employees (name, email, department, salary, hire_date)\n    34→        VALUES (#{name}, #{email}, #{department}, #{salary}, #{hireDate})\n    35→    </insert>\n    36→\n    37→    <!-- Full replace of all user-supplied fields; updated_at set to now -->\n    38→    <update id=\"update\">\n    39→        UPDATE employees\n    40→        SET name        = #{name},\n    41→            email       = #{email},\n    42→            department  = #{department},\n    43→            salary      = #{salary},\n    44→            hire_date   = #{hireDate},\n    45→            updated_at  = CURRENT_TIMESTAMP\n    46→        WHERE id = #{id}\n    47→    </update>\n    48→\n    49→    <delete id=\"delete\">\n    50→        DELETE FROM employees WHERE id = #{id}\n    51→    </delete>\n    52→\n    53→    <select id=\"countAll\" resultType=\"int\">\n    54→        SELECT COUNT(*) FROM employees\n    55→    </select>\n    56→\n    57→    <!--\n    58→        OR search: when both params are provided, a row matches if EITHER column matches.\n    59→        Search is case-insensitive via LOWER(). At least one param is non-null (enforced\n    60→        by the service layer), so the <choose> always produces a valid WHERE clause.\n    61→    -->\n    62→    <select id=\"searchByNameOrDepartment\" resultMap=\"employeeResultMap\">\n    63→        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n    64→        FROM employees\n    65→        <where>\n    66→            <choose>\n    67→                <when test=\"name != null and department != null\">\n    68→                    (LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n    69→                    OR LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%')))\n    70→                </when>\n    71→                <when test=\"name != null\">\n    72→                    LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n    73→                </when>\n    74→                <when test=\"department != null\">\n    75→                    LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%'))\n    76→                </when>\n    77→            </choose>\n    78→        </where>\n    79→        ORDER BY id\n    80→        LIMIT #{limit} OFFSET #{offset}\n    81→    </select>\n    82→\n    83→    <select id=\"countBySearch\" resultType=\"int\">\n    84→        SELECT COUNT(*)\n    85→        FROM employees\n    86→        <where>\n    87→            <choose>\n    88→                <when test=\"name != null and department != null\">\n    89→                    (LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n    90→                    OR LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%')))\n    91→                </when>\n    92→                <when test=\"name != null\">\n    93→                    LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n    94→                </when>\n    95→                <when test=\"department != null\">\n    96→                    LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%'))\n    97→                </when>\n    98→            </choose>\n    99→        </where>\n   100→    </select>\n   101→\n   102→    <select id=\"findByEmail\" resultMap=\"employeeResultMap\">\n   103→        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n   104→        FROM employees\n   105→        WHERE email = #{email}\n   106→    </select>\n   107→\n   108→</mapper>\n   109→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6547310c-c57f-4bb9-bd57-530175104ef3","uuid":"fa1a5819-e06b-4459-8583-f355cd303c09","tool_use_result":{"type":"text","file":{"filePath":"/Users/pinxbot/Desktop/ralph_loop/examples/asis-legacy/src/main/resources/mappers/EmployeeMapper.xml","content":"<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\"\n        \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\">\n\n<mapper namespace=\"com.example.legacy.mapper.EmployeeMapper\">\n\n    <resultMap id=\"employeeResultMap\" type=\"Employee\">\n        <id property=\"id\" column=\"id\"/>\n        <result property=\"name\" column=\"name\"/>\n        <result property=\"email\" column=\"email\"/>\n        <result property=\"department\" column=\"department\"/>\n        <result property=\"salary\" column=\"salary\"/>\n        <result property=\"hireDate\" column=\"hire_date\"/>\n        <result property=\"createdAt\" column=\"created_at\"/>\n        <result property=\"updatedAt\" column=\"updated_at\"/>\n    </resultMap>\n\n    <select id=\"findAll\" resultMap=\"employeeResultMap\">\n        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n        FROM employees\n        ORDER BY id\n        LIMIT #{limit} OFFSET #{offset}\n    </select>\n\n    <select id=\"findById\" resultMap=\"employeeResultMap\">\n        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n        FROM employees\n        WHERE id = #{id}\n    </select>\n\n    <!-- useGeneratedKeys returns the DB-generated PK back into employee.id -->\n    <insert id=\"insert\" useGeneratedKeys=\"true\" keyProperty=\"id\">\n        INSERT INTO employees (name, email, department, salary, hire_date)\n        VALUES (#{name}, #{email}, #{department}, #{salary}, #{hireDate})\n    </insert>\n\n    <!-- Full replace of all user-supplied fields; updated_at set to now -->\n    <update id=\"update\">\n        UPDATE employees\n        SET name        = #{name},\n            email       = #{email},\n            department  = #{department},\n            salary      = #{salary},\n            hire_date   = #{hireDate},\n            updated_at  = CURRENT_TIMESTAMP\n        WHERE id = #{id}\n    </update>\n\n    <delete id=\"delete\">\n        DELETE FROM employees WHERE id = #{id}\n    </delete>\n\n    <select id=\"countAll\" resultType=\"int\">\n        SELECT COUNT(*) FROM employees\n    </select>\n\n    <!--\n        OR search: when both params are provided, a row matches if EITHER column matches.\n        Search is case-insensitive via LOWER(). At least one param is non-null (enforced\n        by the service layer), so the <choose> always produces a valid WHERE clause.\n    -->\n    <select id=\"searchByNameOrDepartment\" resultMap=\"employeeResultMap\">\n        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n        FROM employees\n        <where>\n            <choose>\n                <when test=\"name != null and department != null\">\n                    (LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                    OR LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%')))\n                </when>\n                <when test=\"name != null\">\n                    LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                </when>\n                <when test=\"department != null\">\n                    LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%'))\n                </when>\n            </choose>\n        </where>\n        ORDER BY id\n        LIMIT #{limit} OFFSET #{offset}\n    </select>\n\n    <select id=\"countBySearch\" resultType=\"int\">\n        SELECT COUNT(*)\n        FROM employees\n        <where>\n            <choose>\n                <when test=\"name != null and department != null\">\n                    (LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                    OR LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%')))\n                </when>\n                <when test=\"name != null\">\n                    LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                </when>\n                <when test=\"department != null\">\n                    LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%'))\n                </when>\n            </choose>\n        </where>\n    </select>\n\n    <select id=\"findByEmail\" resultMap=\"employeeResultMap\">\n        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n        FROM employees\n        WHERE email = #{email}\n    </select>\n\n</mapper>\n","numLines":109,"startLine":1,"totalLines":109}}}
