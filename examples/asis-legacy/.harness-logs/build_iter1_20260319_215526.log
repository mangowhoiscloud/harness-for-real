y = salary;\n    }\n\n    public Date getHireDate() {\n        return hireDate;\n    }\n\n    public void setHireDate(Date hireDate) {\n        this.hireDate = hireDate;\n    }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1406,"cache_read_input_tokens":47869,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1406},"output_tokens":18,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"246be9f5-fcf2-42eb-a23d-acfcd7a78b40","uuid":"a71f535b-af7d-45c3-a0d3-2cfad1e483c8"}
