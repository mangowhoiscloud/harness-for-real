rtment, salary, hire_date)\n        VALUES (#{name}, #{email}, #{department}, #{salary}, #{hireDate})\n    </insert>\n\n    <!-- Full replace of all user-supplied fields; updated_at set to now -->\n    <update id=\"update\">\n        UPDATE employees\n        SET name        = #{name},\n            email       = #{email},\n            department  = #{department},\n            salary      = #{salary},\n            hire_date   = #{hireDate},\n            updated_at  = CURRENT_TIMESTAMP\n        WHERE id = #{id}\n    </update>\n\n    <delete id=\"delete\">\n        DELETE FROM employees WHERE id = #{id}\n    </delete>\n\n    <select id=\"countAll\" resultType=\"int\">\n        SELECT COUNT(*) FROM employees\n    </select>\n\n    <!--\n        OR search: when both params are provided, a row matches if EITHER column matches.\n        Search is case-insensitive via LOWER(). At least one param is non-null (enforced\n        by the service layer), so the <choose> always produces a valid WHERE clause.\n    -->\n    <select id=\"searchByNameOrDepartment\" resultMap=\"employeeResultMap\">\n        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n        FROM employees\n        <where>\n            <choose>\n                <when test=\"name != null and department != null\">\n                    (LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                    OR LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%')))\n                </when>\n                <when test=\"name != null\">\n                    LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                </when>\n                <when test=\"department != null\">\n                    LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%'))\n                </when>\n            </choose>\n        </where>\n        ORDER BY id\n        LIMIT #{limit} OFFSET #{offset}\n    </select>\n\n    <select id=\"countBySearch\" resultType=\"int\">\n        SELECT COUNT(*)\n        FROM employees\n        <where>\n            <choose>\n                <when test=\"name != null and department != null\">\n                    (LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                    OR LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%')))\n                </when>\n                <when test=\"name != null\">\n                    LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))\n                </when>\n                <when test=\"department != null\">\n                    LOWER(department) LIKE LOWER(CONCAT('%', #{department}, '%'))\n                </when>\n            </choose>\n        </where>\n    </select>\n\n    <select id=\"findByEmail\" resultMap=\"employeeResultMap\">\n        SELECT id, name, email, department, salary, hire_date, created_at, updated_at\n        FROM employees\n        WHERE email = #{email}\n    </select>\n\n</mapper>\n","structuredPatch":[],"originalFile":null}}
