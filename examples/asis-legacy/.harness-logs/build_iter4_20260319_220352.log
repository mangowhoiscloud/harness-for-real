lemented (Item 5)\n        return new Class<?>[] { AppConfig.class, DatabaseConfig.class };\n    }\n\n    @Override\n    protected Class<?>[] getServletConfigClasses() {\n        return new Class<?>[] { WebConfig.class };\n    }\n\n    @Override\n    protected String[] getServletMappings() {\n        return new String[] { \"/\" };\n    }\n}\n","numLines":23,"startLine":1,"totalLines":23}}}
