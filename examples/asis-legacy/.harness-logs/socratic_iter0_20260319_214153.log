version>${mybatis.version}</version>\n    83→        </dependency>\n    84→        <dependency>\n    85→            <groupId>org.mybatis</groupId>\n    86→            <artifactId>mybatis-spring</artifactId>\n    87→            <version>${mybatis.spring.version}</version>\n    88→        </dependency>\n    89→\n    90→        <!-- Database -->\n    91→        <dependency>\n    92→            <groupId>org.postgresql</groupId>\n    93→            <artifactId>postgresql</artifactId>\n    94→            <version>${postgresql.version}</version>\n    95→            <scope>runtime</scope>\n    96→        </dependency>\n    97→        <dependency>\n    98→            <groupId>org.apache.commons</groupId>\n    99→            <artifactId>commons-dbcp2</artifactId>\n   100→            <version>${commons.dbcp2.version}</version>\n   101→        </dependency>\n   102→\n   103→        <!-- Jackson JSON -->\n   104→        <dependency>\n   105→            <groupId>com.fasterxml.jackson.core</groupId>\n   106→            <artifactId>jackson-databind</artifactId>\n   107→            <version>${jackson.version}</version>\n   108→        </dependency>\n   109→\n   110→        <!-- Validation -->\n   111→        <dependency>\n   112→            <groupId>javax.validation</groupId>\n   113→            <artifactId>validation-api</artifactId>\n   114→            <version>${javax.validation.version}</version>\n   115→        </dependency>\n   116→        <dependency>\n   117→            <groupId>org.hibernate</groupId>\n   118→            <artifactId>hibernate-validator</artifactId>\n   119→            <version>${hibernate.validator.version}</version>\n   120→        </dependency>\n   121→        <dependency>\n   122→            <groupId>javax.el</groupId>\n   123→            <artifactId>javax.el-api</artifactId>\n   124→            <version>${javax.el.version}</version>\n   125→        </dependency>\n   126→        <dependency>\n   127→            <groupId>org.glassfish</groupId>\n   128→  