{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "Bash(chmod:*)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/loop.sh 2>&1)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/init.sh 2>&1)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/scripts/monitor.sh 2>&1)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/loop.sh)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh repo:*)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "command": "bash hooks/backpressure.sh"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "command": "bash hooks/pre-commit-gate.sh"
      }
    ]
  }
}
