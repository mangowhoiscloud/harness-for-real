{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "WebSearch",
      "WebFetch",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/init.sh)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/scripts/monitor.sh)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/scripts/test-ratio.sh)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/hooks/backpressure.sh)",
      "Bash(bash -n /Users/mango/workspace/harness-for-real/hooks/pre-commit-gate.sh)",
      "Bash(grep -r v1.0.0 /Users/mango/workspace/harness-for-real/PROMPT*.md)",
      "Bash(grep -n \"500\\\\|100\" /Users/mango/workspace/harness-for-real/PROMPT_*.md)",
      "Bash(grep:*)",
      "Bash(xargs ls:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "command": "timeout 90 bash hooks/backpressure.sh"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "command": "timeout 180 bash hooks/pre-commit-gate.sh"
      }
    ]
  }
}
